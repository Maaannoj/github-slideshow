{
  "name": "job-application-tracker",
  "version": "2.0.0",
  "description": "Desktop app that connects to your Gmail and automatically tracks the status of your job applications.",
  "main": "src/main/main.js",
  "author": "Job Application Tracker",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/parser.test.js",
    "build": "electron-builder --publish never"
  },
  "build": {
    "appId": "com.local.jobapplicationtracker",
    "productName": "Job Application Tracker",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "artifactName": "JobApplicationTracker-Setup-${version}.${ext}",
    "mac": { "category": "public.app-category.productivity", "target": "dmg" },
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Job Application Tracker"
    },
    "linux": { "target": "AppImage" }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
